# Required when the notebook downloads ACS data.
# Never commit a real Census API key; put it in the ignored .env file.
CENSUS_API_KEY=

# Stage 1 PostgreSQL loader and local Compose service.
# Add these entries to your existing .env; do not overwrite your Census key.
# Choose a local password before starting Compose. Keep it out of Git and logs.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=walkability
POSTGRES_USER=walkability
POSTGRES_PASSWORD=
